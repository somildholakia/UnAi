# OpenAI-compatible local model endpoint. Ollama commonly exposes /v1 here.
UNAI_MODEL_BASE_URL=http://127.0.0.1:11434/v1
UNAI_MODEL_NAME=qwen3-coder:latest
UNAI_MODEL_API_KEY=
UNAI_MODEL_TIMEOUT_SECONDS=180
UNAI_CORS_ORIGINS=http://localhost:5173

# Working memory and execution limits
UNAI_WORKSPACE_ROOT=.workspaces
UNAI_DOCKER_IMAGE=unai-python-test:latest
UNAI_SANDBOX_TIMEOUT_SECONDS=120
UNAI_MEMORY_PATH=.data/trajectories.sqlite3
UNAI_MAX_CANDIDATES=2
UNAI_MAX_CONTEXT_TOKENS=4096
UNAI_MOBILE_PROFILE=android-6gb-cpu

# Obsidian-compatible Markdown brain (Markdown files are canonical)
UNAI_BRAIN_VAULT_ROOT=.brain-vault
UNAI_BRAIN_INDEX_PATH=.data/brain.sqlite3
UNAI_EVIDENCE_DB_PATH=.data/evidence.sqlite3
UNAI_TEST_TIMEOUT_SECONDS=120
UNAI_TEST_MAX_FILES=5000
UNAI_TEST_MAX_BYTES=52428800
# Leave blank only for local loopback use; hosted writes require a server-side secret.
UNAI_BRAIN_WRITE_TOKEN=

# Remote read-only MCP bridge settings (optional)
UNAI_BRAIN_API_URL=
UNAI_BRAIN_API_TOKEN=
