# Local llama.cpp OpenAI-compatible server (Termux installer default).
UNAI_MODEL_BASE_URL=http://127.0.0.1:8080/v1
UNAI_MODEL_NAME=unai-local-coder
UNAI_MODEL_API_KEY=
UNAI_MODEL_TIMEOUT_SECONDS=180
# Optional OpenAI-compatible model IDs for separately served M5 LoRA adapters.
# Leave blank until the corresponding specialist adapter is trained and served.
# A requested specialist returns 503 when its model name is not configured.
UNAI_SPECIALIST_NEXT_ACTION_MODEL=
UNAI_SPECIALIST_PLANNER_MODEL=
UNAI_SPECIALIST_VERIFIER_MODEL=
UNAI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Engine API perimeter. Leave blank for loopback-only local use.
# For remote clients, set a random secret of at least 32 characters:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
UNAI_API_TOKEN=
# Scoped token registry stores hashes only. Tenant workspace and data roots are
# separate so task/evidence, Brain and code-graph state do not cross tenant boundaries.
UNAI_API_TOKEN_STORE_PATH=.data/api-tokens.sqlite3
UNAI_TENANT_WORKSPACE_ROOT=.tenant-workspaces
UNAI_TENANT_DATA_ROOT=.data/tenants
UNAI_API_RATE_LIMIT_PER_MINUTE=600

# Working memory and execution limits
UNAI_WORKSPACE_ROOT=.workspaces
UNAI_DOCKER_IMAGE=unai-python-test:latest
UNAI_SANDBOX_TIMEOUT_SECONDS=120
UNAI_MEMORY_PATH=.data/trajectories.sqlite3
UNAI_MAX_CANDIDATES=2
UNAI_MAX_CONTEXT_TOKENS=4096
UNAI_MOBILE_PROFILE=android-6gb-cpu

# Obsidian-compatible Markdown brain (Markdown files are canonical)
UNAI_BRAIN_VAULT_ROOT=.brain-vault
UNAI_BRAIN_INDEX_PATH=.data/brain.sqlite3
UNAI_EVIDENCE_DB_PATH=.data/evidence.sqlite3
# Incremental Python repository graph cache (source bodies are never stored).
UNAI_CODE_GRAPH_DB_PATH=.data/code-graph.sqlite3
UNAI_TEST_TIMEOUT_SECONDS=120
UNAI_TEST_MAX_FILES=5000
UNAI_TEST_MAX_BYTES=52428800
# Leave blank only for local loopback use; hosted writes require a server-side secret.
UNAI_BRAIN_WRITE_TOKEN=

# Publisher trust: choose ONE configuration mode.
# Direct operator-managed keyring (backward-compatible):
# UNAI_ORACLE_TRUSTED_PUBLISHER_KEYS maps key IDs to public_key_b64, issuer,
# allowed_domains, and optional not_before/not_after/revoked.
UNAI_ORACLE_TRUSTED_PUBLISHER_KEYS={}
# OR an offline root-signed trust-bundle snapshot. Pin root public keys here;
# the bundle is canonical JSON signed by one of these Ed25519 roots.
# Raise MIN_SEQUENCE to the last accepted sequence when advancing the bundle.
UNAI_ORACLE_PUBLISHER_TRUST_ROOTS={}
UNAI_ORACLE_PUBLISHER_TRUST_BUNDLE=
UNAI_ORACLE_PUBLISHER_TRUST_MIN_SEQUENCE=0

# Remote read-only MCP bridge settings (optional)
UNAI_BRAIN_API_URL=
UNAI_BRAIN_API_TOKEN=

# Local read-only task MCP bridge. Keep the workspace read grant disabled until you
# explicitly choose one workspace. These values are read by the MCP server process.
UNAI_ENGINE_API_URL=http://127.0.0.1:8000
UNAI_ENGINE_API_TOKEN=
UNAI_MCP_WORKSPACE=
UNAI_MCP_ALLOW_WORKSPACE_READ=false
